# Browser key for the Maps JavaScript API (safe to expose, but LOCK IT DOWN with
# an HTTP referrer restriction in Google Cloud, see README.md).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud > Map Management for custom map styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server key for Geocoding + Distance Matrix (travel times in planner).
# Can reuse the browser key if those APIs are enabled on it.
GOOGLE_MAPS_API_KEY=

# Supabase (Digital Alchemy Website project) — server only, never NEXT_PUBLIC_
SUPABASE_URL=https://dpjhklcjrnqacewnvoue.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret for exporting collected emails: GET /api/emails?secret=...
ADMIN_EXPORT_SECRET=
